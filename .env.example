# AuraLead AI environment. `npm run setup` copies this file to .env (the only env file)
# and generates the demo secrets left blank below. Real environment variables always win
# over .env (src/lib/env-load.ts). Never commit .env. Provider API keys are not env vars:
# they are per-workspace encrypted Integration secrets.

# Mode: demo | live. One process serves one mode and opens one DB (ADR-04).
APP_MODE=demo
# Build-time copy for the client bundle; must equal APP_MODE.
NEXT_PUBLIC_APP_MODE=demo
APP_ORIGIN=http://localhost:3000

# Data locations. Default data dir: %LOCALAPPDATA%\auralead (Windows) or
# ~/.local/share/auralead; the mode folder is appended. Keep them out of OneDrive (ADR-20).
AURALEAD_DATA_DIR=
# Optional SQLite override, e.g. file:C:/data/auralead.db
DATABASE_URL=
STORAGE_DIR=
BACKUP_DIR=

# Secrets. Generated by `npm run setup` for local use; LIVE refuses to boot without them.
# Back up SUPPRESSION_PEPPER and the key ring together: losing them makes suppressions
# unmatchable and stored credentials unreadable.
SESSION_SECRET=
SHARE_NONCE_KEY=
SUPPRESSION_PEPPER=
# JSON object of kid -> base64(32 bytes), e.g. {"k1":"..."}
CREDENTIALS_KEYRING=
CREDENTIALS_ACTIVE_KID=k1

# Outbound kill switch (1 pauses all provider sends).
OUTBOUND_PAUSED=0

# Test control endpoints (/api/test/*): DEMO only, refused in LIVE.
AURALEAD_TEST_CONTROL=0
TEST_CONTROL_TOKEN=

# Meta webhook verification and API versions. Set the versions you verified in
# docs/integrations.md (format v24.0); empty means not configured.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
META_MARKETING_VERSION=

# Trust X-Forwarded-For only behind this many reverse proxies. At 0 the client address is unknown, so every
# client shares one rate-limit bucket: fine for a local run, refused at boot for LIVE behind HTTPS (set 1 behind one proxy).
TRUSTED_PROXY_HOPS=0
# LIVE must be served over https (APP_ORIGIN=https://...) or on localhost; boot refuses a plain-HTTP public host.
# 1 = cookie without the __Host- prefix and Secure flag, for non-localhost dev hosts only.
AUTH_COOKIE_INSECURE_DEV=0

# Seed clock (ISO 8601). Empty = current time floored to the hour.
SEED_NOW=
LOG_LEVEL=info
