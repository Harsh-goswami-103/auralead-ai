{
  "name": "auralead-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "worker": "tsx worker/index.ts",
    "dev:all": "concurrently -n web,worker -c blue,magenta \"npm:dev\" \"npm:worker\"",
    "build": "prisma generate && next build && tsup --entry.worker worker/index.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "start": "next start",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:components": "vitest run --project components",
    "test:e2e": "playwright test",
    "setup": "tsx scripts/setup.ts",
    "db:path": "tsx scripts/db-path.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate deploy && tsx prisma/seed/index.ts --reset",
    "demo:refresh": "tsx scripts/demo-refresh.ts",
    "pipeline:resume": "tsx scripts/pipeline-resume.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "lead:erase": "tsx scripts/lead-erase.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@hookform/resolvers": "5.9.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-table": "8.21.3",
    "@xyflow/react": "12.12.0",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dotenv": "18.0.8",
    "google-auth-library": "11.3.0",
    "ipaddr.js": "2.5.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "next": "16.4.1",
    "nodemailer": "10.1.1",
    "openai": "7.34.0",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "resend": "6.33.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "tw-animate-css": "1.4.0",
    "undici": "8.12.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "fast-check": "4.10.2",
    "get-port": "7.2.0",
    "jsdom": "30.1.3",
    "pdfjs-dist": "6.4.299",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5"
  }
}
