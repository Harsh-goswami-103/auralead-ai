/// explicit "Generate with local template" action (C13).
enum AiDraftTrigger {
  PIPELINE
  MANUAL
  LOCAL_EXPLICIT
}

// ---- Identity, tenancy, settings (plan §5.2) -------------------------------------------------

model Workspace {
  id                    String          @id @default(cuid(2))
  slug                  String          @unique
  name                  String
  mode                  AppMode
  planLabel             String
  timezone              String          @default("Asia/Kolkata")
  status                WorkspaceStatus @default(ACTIVE)
  automationPaused      Boolean         @default(false)
  automationPauseReason String?
  createdAt             DateTime        @default(now())

  settings               WorkspaceSettings?
  memberships            Membership[]
  employeeAssignments    EmployeeAssignment[]
  invites                Invite[]
  leads                  Lead[]
  importBatches          ImportBatch[]
  suppressions           Suppression[]
  scoringConfigVersions  ScoringConfigVersion[]
  services               Service[]
  pricingVersions        PricingVersion[]
  approvals              Approval[]
  integrations           Integration[]
  extensionTokens        ExtensionToken[]
  campaigns              Campaign[]
  pipelineConfigVersions PipelineConfigVersion[]
  bulkRuns               BulkRun[]
  leadExports            LeadExport[]
}

model WorkspaceSettings {
  workspaceId                String    @id
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  autoSendEnabled            Boolean   @default(false)
  /// M2 / ADR-14: attested B2B email for Maps leads, manual-only.
  emailB2bAttestationEnabled Boolean   @default(false)
  emailFallbackEnabled       Boolean   @default(false)
  taxLabel                   String?
  taxBps                     Int?
  taxMode                    TaxMode   @default(NONE)
  maxDiscountBps             Int
  quoteValidityDays          Int       @default(15)
  gstin                      String?
  brandColor                 String
  logoPath                   String?
  termsText                  String
  /// https only (P4).
  bookingUrl                 String?
  internalWaDailyCap         Int?
  internalEmailDailyCap      Int?
  /// Fixed INR.
  currencyDisplay            String    @default("INR")
  updatedAt                  DateTime  @updatedAt
  updatedBy                  String?
}

/// Singleton (id = 1). The worker also honors STORAGE_DIR/outbound.lock and OUTBOUND_PAUSED=1 (O1).
model SystemSetting {
  id                  Int       @id @default(1)
  outboundPaused      Boolean   @default(false)
  outboundPausedAt    DateTime?
  outboundPausedBy    String?
  outboundPauseReason String?
}

model User {
  id               String     @id @default(cuid(2))
  /// Always lowercased.
  email            String     @unique
  name             String
  globalRole       GlobalRole
  status           UserStatus @default(ACTIVE)
  passwordHash     String?
  isDemo           Boolean    @default(false)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  lastLoginAt      DateTime?

  sessions            Session[]
  memberships         Membership[]
  employeeAssignments EmployeeAssignment[]
  passwordResets      PasswordReset[]
}

model Session {
  id                String    @id @default(cuid(2))
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the 32-byte cookie token; the token itself is never stored.
  tokenHash         String    @unique
  activeWorkspaceId String?
  mode              AppMode
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  ipHash            String
  userAgent         String
  revokedAt         DateTime?
  reauthAt          DateTime?

  @@index([userId, revokedAt])
}

model Invite {
  id             String          @id @default(cuid(2))
  email          String
  tokenHash      String          @unique
  globalRole     GlobalRole
  /// Null for a platform-level (employee or admin) invite.
  workspaceId    String?
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  membershipRole MembershipRole?
  createdBy      String
  /// 72 h after creation.
  expiresAt      DateTime
  redeemedAt     DateTime?
  createdAt      DateTime        @default(now())

  @@index([workspaceId, createdAt])
}

/// Single-use password reset link (ADR-67). Issued by a super admin or the operator, valid one hour,
/// superseded by any newer token of the same user. Only the sha256 of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// A user id, or `system:operator` for the break-glass CLI.
  createdBy String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Membership {
  id          String         @id @default(cuid(2))
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  role        MembershipRole
  createdAt   DateTime       @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model EmployeeAssignment {
  id             String    @id @default(cuid(2))
  employeeUserId String
  employee       User      @relation(fields: [employeeUserId], references: [id], onDelete: Restrict)
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// string[] of Capability (src/lib/domain/enums.ts).
  capabilities   Json
  maxDiscountBps Int?
  active         Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())

  @@unique([employeeUserId, workspaceId])
  @@index([workspaceId, active])
}

/// Singleton (id = 1). Read only when DEMO + test-control flag + token (A40).
model TestClock {
  id       Int       @id @default(1)
  offsetMs BigInt    @default(0)
  frozenAt DateTime?
}

// ---- Leads and ingestion (plan §5.3) ---------------------------------------------------------

model Lead {
  id                      String                 @id @default(cuid(2))
  workspaceId             String
  workspace               Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  displayName             String
  nameNormalized          String
  category                String?
  phoneE164               String?
  phoneRaw                String?
  alternatePhones         Json
  emailNormalized         String?
  website                 String?
  websiteStatus           WebsiteStatus          @default(UNKNOWN)
  /// Latest website check (T12, ADR-53): {schemaVersion, untrusted: true, checkedAt, url, finalUrl,
  /// httpStatus, contentType, bytes, truncated, redirects, downgraded, reasonCode, title, text}.
  /// `text` is stripped page text: untrusted data, never instructions. Never filtered on.
  websiteEnrichment       Json?
  address                 String?
  city                    String?
  /// Rating x10 (4.5 stars is 45).
  rating                  Int?
  reviewCount             Int?
  salesStage              SalesStage             @default(NEW)
  stageVersion            Int                    @default(0)
  score                   Int?
  scoreReasons            Json
  unknownInputs           Json
  scoreConfigVersionId    String?
  scoreConfigVersion      ScoringConfigVersion?  @relation(fields: [workspaceId, scoreConfigVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Pinned at ingestion (O5).
  pipelineConfigVersionId String?
  pipelineConfigVersion   PipelineConfigVersion? @relation(fields: [workspaceId, pipelineConfigVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  firstSource             LeadSource
  simulated               Boolean                @default(false)
  mergedIntoLeadId        String?
  mergedInto              Lead?                  @relation("LeadMerge", fields: [workspaceId, mergedIntoLeadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  mergedFrom              Lead[]                 @relation("LeadMerge")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  contactKeys        LeadContactKey[]
  sourceRecords      LeadSourceRecord[]
  consentRecords     ConsentRecord[]
  quotes             Quote[]
  conversations      Conversation[]
  callRequests       CallRequest[]
  pipelineExecutions PipelineExecution[]
  aiDrafts           AiDraft[]

  @@unique([workspaceId, id])
  @@index([workspaceId, salesStage, createdAt])
  @@index([workspaceId, score])
  @@index([workspaceId, nameNormalized])
  @@index([workspaceId, phoneE164])
  @@index([workspaceId, emailNormalized])
  @@index([workspaceId, createdAt, id])
}

model LeadContactKey {
  id          String         @id @default(cuid(2))
  workspaceId String
  leadId      String
  lead        Lead           @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Restrict)
  kind        ContactKeyKind
  /// E.164 phone, normalized email, or `source:providerId` (G-NORM-1).
  value       String

  @@unique([workspaceId, kind, value])
  @@index([leadId])
}

model LeadSourceRecord {
  id                 String             @id @default(cuid(2))
  workspaceId        String
  leadId             String?
  lead               Lead?              @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  importBatchId      String?
  importBatch        ImportBatch?       @relation(fields: [workspaceId, importBatchId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  source             LeadSource
  /// leadgen_id, sheet event id, or extension sourceRef.
  externalId         String
  status             SourceRecordStatus
  reasonCode         String?
  rawPayloadRedacted Json
  mappingVersion     Int?
  /// ad, form, campaign, sheet, keyword.
  attribution        Json
  extractedAt        DateTime?
  receivedAt         DateTime

  mergeReviews MergeReview[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, source, externalId])
  @@index([importBatchId])
  @@index([leadId])
}

model ImportBatch {
  id               String            @id @default(cuid(2))
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  source           LeadSource
  /// Extension batchId or sheet sync run id.
  externalBatchId  String
  extensionTokenId String?
  extensionToken   ExtensionToken?   @relation(fields: [workspaceId, extensionTokenId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  bodyHash         String
  status           ImportBatchStatus @default(RECEIVED)
  /// {received, accepted, duplicate, review, rejected}
  counts           Json
  simulated        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  completedAt      DateTime?

  sourceRecords LeadSourceRecord[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, source, externalBatchId])
}

model MergeReview {
  id               String            @id @default(cuid(2))
  workspaceId      String
  sourceRecordId   String
  sourceRecord     LeadSourceRecord  @relation(fields: [workspaceId, sourceRecordId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  candidateLeadIds Json
  status           MergeReviewStatus @default(OPEN)
  resolvedBy       String?
  resolvedAt       DateTime?
  resolution       Json?
  createdAt        DateTime          @default(now())

  @@index([workspaceId, status, createdAt])
}

model ConsentRecord {
  id               String         @id @default(cuid(2))
  workspaceId      String
  leadId           String
  lead             Lead           @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// HMAC contact key, same derivation as Suppression.contactKey.
  contactKey       String
  channel          Channel
  purpose          ConsentPurpose
  basis            ConsentBasis
  source           ConsentSource
  /// {formId, responseId, questionKey, messageId, attestedBy, note}
  evidence         Json
  noticeTextHash   String?
  noticeVersion    String?
  /// Evidence time (provider or form submission time).
  collectedAt      DateTime
  recordedAt       DateTime
  recordedBy       String?
  withdrawnAt      DateTime?
  withdrawalMethod String?

  @@unique([workspaceId, id])
  @@index([workspaceId, leadId, channel, collectedAt])
  @@index([workspaceId, contactKey, channel])
}

/// Append-only history (E3, ADR-37). At most one active (clearedAt IS NULL) row per
/// (workspaceId, channel, contactKey). Keyed on the contact, not the lead, so it survives lead
/// merge and deletion; clearedByConsentId is therefore service-enforced, not a foreign key.
model Suppression {
  id                 String            @id @default(cuid(2))
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  channel            Channel
  /// HMAC-SHA256(SUPPRESSION_PEPPER, normalized contact) (C17, ADR-19).
  contactKey         String
  /// Nulled on lead erasure.
  contactPlain       String?
  reason             SuppressionReason
  sourceEventId      String?
  createdAt          DateTime          @default(now())
  clearedAt          DateTime?
  clearedByConsentId String?
  /// SuppressionJournal (E8, ADR-38).
  journaledAt        DateTime?
  clearJournaledAt   DateTime?

  @@unique([workspaceId, channel, contactKey], map: "Suppression_active_contact_key", where: raw("\"clearedAt\" IS NULL"))
  @@index([workspaceId, channel, contactKey, createdAt])
}

model ScoringConfigVersion {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  version     Int
  /// Zod-validated weights.
  weights     Json
  active      Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())

  leads Lead[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, version])
  @@unique([workspaceId], map: "ScoringConfigVersion_one_active", where: raw("\"active\""))
}

model SheetMapping {
  id                String      @id @default(cuid(2))
  workspaceId       String
  integrationId     String
  integration       Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  version           Int
  headerFingerprint String
  fieldMap          Json
  /// {column, truthyValues[], channel, purpose, noticeText, noticeTextHash} (P1)
  consentMapping    Json?
  active            Boolean     @default(false)
  /// T34 (ADR-103): the normalized header names the fingerprint was taken from, so drift can be
  /// shown as a column diff. Null on mappings made before T34 (the DEMO simulator's).
  headerColumns     Json?
  /// T34: the column holding the form submission time (the consent evidence time).
  submittedAtColumn String?

  @@unique([integrationId, version])
  @@index([workspaceId, integrationId])
}

model MetaFormMapping {
  id             String      @id @default(cuid(2))
  workspaceId    String
  integrationId  String
  integration    Integration @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  formId         String
  fieldMap       Json
  /// (P1)
  consentMapping Json?

  @@unique([integrationId, formId])
  @@index([workspaceId, integrationId])
}

// ---- Pricing and quotes (plan §5.4) ----------------------------------------------------------

model Service {
  id                  String    @id @default(cuid(2))
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  code                String
  name                String
  description         String
  unitLabel           String
  defaultTimelineDays Int?
  maxDiscountBps      Int?
  archivedAt          DateTime?

  priceEntries PriceEntry[]
  quoteItems   QuoteItem[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, code])
}

model PricingVersion {
  id          String    @id @default(cuid(2))
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  version     Int
  active      Boolean   @default(false)
  note        String
  createdBy   String
  createdAt   DateTime  @default(now())

  entries       PriceEntry[]
  quoteVersions QuoteVersion[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, version])
  @@unique([workspaceId], map: "PricingVersion_one_active", where: raw("\"active\""))
}

model PriceEntry {
  id               String         @id @default(cuid(2))
  workspaceId      String
  pricingVersionId String
  pricingVersion   PricingVersion @relation(fields: [workspaceId, pricingVersionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Restrict)
  serviceId        String
  service          Service        @relation(fields: [workspaceId, serviceId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  unitPricePaise   BigInt
  minQty           Int            @default(1)
  maxQty           Int            @default(10000)

  @@unique([pricingVersionId, serviceId])
  @@index([workspaceId])
}

model Quote {
  id                 String        @id @default(cuid(2))
  workspaceId        String
  leadId             String
  lead               Lead          @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Q-0001 per workspace.
  number             String
  status             QuoteStatus   @default(DRAFT)
  /// Null only inside the creating transaction, before version 1 exists (circular reference).
  currentVersionId   String?
  currentVersion     QuoteVersion? @relation("QuoteCurrentVersion", fields: [workspaceId, currentVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  currentVersionNo   Int           @default(0)
  needsPricingReview Boolean       @default(false)
  sentVia            QuoteSentVia?
  /// Copy of the current version's validUntil.
  validUntil         DateTime?
  acceptedVersionId  String?
  acceptedVersion    QuoteVersion? @relation("QuoteAcceptedVersion", fields: [workspaceId, acceptedVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  versions    QuoteVersion[]    @relation("QuoteVersions")
  shares      QuoteShare[]
  acceptances QuoteAcceptance[]
  approvals   Approval[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, number])
  @@index([workspaceId, status, updatedAt])
  @@index([leadId])
}

model QuoteVersion {
  id               String         @id @default(cuid(2))
  workspaceId      String
  quoteId          String
  quote            Quote          @relation("QuoteVersions", fields: [workspaceId, quoteId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  versionNo        Int
  pricingVersionId String
  pricingVersion   PricingVersion @relation(fields: [workspaceId, pricingVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Service names, unit prices, rules, branding refs.
  snapshot         Json
  scopeText        String
  timelineText     String
  discountKind     DiscountKind   @default(NONE)
  /// Basis points or paise, depending on discountKind.
  discountValue    BigInt         @default(0)
  taxLabel         String?
  taxBps           Int?
  subtotalPaise    BigInt
  discountPaise    BigInt
  taxablePaise     BigInt
  taxPaise         BigInt
  totalPaise       BigInt
  validUntil       DateTime
  /// Set by dispatch settle even when the version is superseded (E6, ADR-40).
  sentAt           DateTime?
  aiPolicyFlags    Json
  reviewReasons    Json
  createdBy        String
  createdAt        DateTime       @default(now())

  items            QuoteItem[]
  currentOf        Quote[]           @relation("QuoteCurrentVersion")
  acceptedOf       Quote[]           @relation("QuoteAcceptedVersion")
  shares           QuoteShare[]
  viewEvents       QuoteViewEvent[]
  acceptances      QuoteAcceptance[]
  artifacts        QuoteArtifact[]
  approvals        Approval[]
  messages         Message[]
  dispatchAttempts DispatchAttempt[]

  @@unique([workspaceId, id])
  @@unique([quoteId, versionNo])
}

model QuoteItem {
  id                  String       @id @default(cuid(2))
  workspaceId         String
  quoteVersionId      String
  quoteVersion        QuoteVersion @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Restrict)
  serviceId           String
  service             Service      @relation(fields: [workspaceId, serviceId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  serviceNameSnapshot String
  unitLabel           String
  qty                 Int
  unitPricePaise      BigInt
  lineTotalPaise      BigInt
  position            Int

  @@unique([quoteVersionId, position])
  @@index([workspaceId])
}

model QuoteShare {
  id             String       @id @default(cuid(2))
  workspaceId    String
  quoteId        String
  quote          Quote        @relation(fields: [workspaceId, quoteId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  quoteVersionId String
  quoteVersion   QuoteVersion @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// sha256 of 32 random bytes, base64url (C2).
  tokenHash      String       @unique
  /// <= validUntil (P16).
  expiresAt      DateTime
  revokedAt      DateTime?
  supersededAt   DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())

  viewEvents QuoteViewEvent[]

  @@unique([workspaceId, id])
  @@index([quoteVersionId])
}

model QuoteViewEvent {
  id             String        @id @default(cuid(2))
  workspaceId    String
  quoteShareId   String
  quoteShare     QuoteShare    @relation(fields: [workspaceId, quoteShareId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  quoteVersionId String
  quoteVersion   QuoteVersion  @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  kind           QuoteViewKind
  uaClass        UaClass
  ipHash         String
  createdAt      DateTime      @default(now())

  @@index([quoteShareId, createdAt])
  @@index([workspaceId, createdAt])
}

model QuoteAcceptance {
  id             String       @id @default(cuid(2))
  workspaceId    String
  quoteId        String
  quote          Quote        @relation(fields: [workspaceId, quoteId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// UNIQUE: accept is idempotent per version.
  quoteVersionId String       @unique
  quoteVersion   QuoteVersion @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  acceptorName   String
  ipHash         String
  userAgent      String
  acceptedAt     DateTime

  @@index([workspaceId, acceptedAt])
}

model QuoteArtifact {
  id             String       @id @default(cuid(2))
  workspaceId    String
  quoteVersionId String       @unique
  quoteVersion   QuoteVersion @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Relative to STORAGE_DIR.
  path           String
  sha256         String
  bytes          Int
  renderedAt     DateTime

  @@index([workspaceId, renderedAt])
}

model Approval {
  id                 String         @id @default(cuid(2))
  workspaceId        String
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  kind               ApprovalKind
  status             ApprovalStatus @default(PENDING)
  quoteId            String?
  quote              Quote?         @relation(fields: [workspaceId, quoteId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  quoteVersionId     String?
  quoteVersion       QuoteVersion?  @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  messageId          String?
  message            Message?       @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// O3: sha256 of the canonical outbound payload JSON.
  payloadHash        String?
  /// customer_requested, ai_price_ignored, ...
  flags              Json
  requestedAt        DateTime
  decidedBy          String?
  decidedAt          DateTime?
  invalidatedAt      DateTime?
  invalidationReason String?

  dispatchAttempts DispatchAttempt[]

  @@unique([workspaceId, id])
  @@unique([quoteVersionId], map: "Approval_one_approved_per_quote_version", where: raw("\"kind\" = 'QUOTE_VERSION' AND \"status\" = 'APPROVED'"))
  @@unique([messageId], map: "Approval_one_open_per_message", where: raw("\"status\" IN ('PENDING', 'APPROVED')"))
  @@index([workspaceId, status, requestedAt])
}

// ---- Messaging (plan §5.5) -------------------------------------------------------------------

model Conversation {
  id                      String             @id @default(cuid(2))
  workspaceId             String
  leadId                  String
  lead                    Lead               @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  channel                 Channel
  contactKey              String
  aiMode                  ConversationAiMode @default(DRAFT)
  humanTakeover           Boolean            @default(false)
  modeVersion             Int                @default(0)
  /// Monotone max of valid inbound provider timestamps (C19).
  lastInboundProviderAt   DateTime?
  lastInboundMessageId    String?
  unansweredOutboundCount Int                @default(0)
  /// P5.
  emailThreadToken        String?
  /// Null while the conversation is open; the partial unique allows one open conversation per
  /// lead and channel (ADR-47).
  closedAt                DateTime?
  createdAt               DateTime           @default(now())

  messages     Message[]
  callRequests CallRequest[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, leadId, channel], map: "Conversation_one_open_per_lead_channel", where: raw("\"closedAt\" IS NULL"))
  @@index([workspaceId, lastInboundProviderAt])
  @@index([workspaceId, leadId, channel])
}

model Message {
  id                  String            @id @default(cuid(2))
  workspaceId         String
  conversationId      String
  conversation        Conversation      @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  direction           MessageDirection
  /// Also the provider namespace of providerMessageId.
  channel             Channel
  kind                MessageKind
  body                String?
  subject             String?
  templateId          String?
  template            WhatsAppTemplate? @relation(fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  variables           Json?
  quoteVersionId      String?
  quoteVersion        QuoteVersion?     @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Projection of delivery state (C10).
  status              MessageStatus
  statusRank          Int               @default(0)
  providerMessageId   String?
  providerTs          DateTime?
  /// anthropic, openai, local-deterministic, human.
  generatorLabel      String?
  simulated           Boolean           @default(false)
  replyToInboundId    String?
  replyToInbound      Message?          @relation("MessageReply", fields: [workspaceId, replyToInboundId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  replies             Message[]         @relation("MessageReply")
  modeVersionAtCreate Int?
  /// Outbound only (E4, ADR-45).
  sendIntent          SendIntent?
  /// userId or `system:<jobType>`.
  initiatedBy         String?
  createdBy           String?
  createdAt           DateTime          @default(now())

  statusEvents     MessageStatusEvent[]
  dispatchAttempts DispatchAttempt[]
  approvals        Approval[]

  @@unique([workspaceId, id])
  /// (provider, providerMessageId) UNIQUE where not null: NULLs are distinct in SQLite and PostgreSQL.
  @@unique([channel, providerMessageId])
  @@index([conversationId, createdAt])
}

model MessageStatusEvent {
  id                String   @id @default(cuid(2))
  workspaceId       String
  messageId         String?
  message           Message? @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  providerMessageId String
  /// Raw provider status string.
  status            String
  rank              Int
  providerTs        DateTime
  errorCode         String?
  anomaly           Boolean  @default(false)
  receivedAt        DateTime

  @@unique([providerMessageId, status])
  @@index([workspaceId, receivedAt])
}

/// The outbox (C7, ADR-05). Every outbound provider mutation goes through one of these rows.
model DispatchAttempt {
  id                String                @id @default(cuid(2))
  workspaceId       String
  messageId         String
  message           Message               @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  quoteVersionId    String?
  quoteVersion      QuoteVersion?         @relation(fields: [workspaceId, quoteVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  approvalId        String?
  approval          Approval?             @relation(fields: [workspaceId, approvalId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  channel           Channel
  attemptNo         Int
  state             DispatchState         @default(QUEUED)
  /// Copied from Message, immutable (E4, ADR-45).
  sendIntent        SendIntent
  initiatedBy       String
  /// E7, ADR-41.
  failureClass      DispatchFailureClass?
  idempotencyKey    String                @unique
  jobId             String
  job               Job                   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  providerMessageId String?
  reasonCode        String?
  errorRedacted     String?
  resolvedBy        String?
  resolvedAt        DateTime?
  resolutionNote    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([messageId, attemptNo])
  /// providerMessageId UNIQUE per provider namespace (plan §4.4); NULLs are distinct.
  @@unique([channel, providerMessageId])
  @@index([workspaceId, state])
  @@index([jobId])
}

model CallRequest {
  id             String            @id @default(cuid(2))
  workspaceId    String
  leadId         String
  lead           Lead              @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  conversationId String?
  conversation   Conversation?     @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  source         CallRequestSource
  status         CallRequestStatus @default(OPEN)
  requestedAt    DateTime
  handledBy      String?
  handledAt      DateTime?
  /// UNIQUE: a replayed quick reply creates no second request.
  sourceEventId  String?           @unique

  @@index([workspaceId, status, requestedAt])
}

model WhatsAppTemplate {
  id              String          @id @default(cuid(2))
  workspaceId     String
  integrationId   String
  integration     Integration     @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  name            String
  language        String
  /// Raw provider string, never an enum (12.3).
  category        String
  /// Raw provider string, never an enum (12.3).
  status          String
  components      Json
  variableSchema  Json
  intent          TemplateIntent?
  variableMap     Json
  categoryHistory Json
  syncedAt        DateTime

  messages Message[]

  @@unique([workspaceId, id])
  @@unique([integrationId, name, language])
}

// ---- Campaigns, integrations, extension (plan §5.6) ------------------------------------------

model Campaign {
  id                 String       @id @default(cuid(2))
  workspaceId        String
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  integrationId      String?
  integration        Integration? @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  providerCampaignId String
  name               String
  /// Ad account currency (P6).
  currency           String
  /// Raw provider string.
  configuredStatus   String
  /// Raw provider string.
  effectiveStatus    String
  lastSyncedAt       DateTime?
  simulated          Boolean      @default(false)

  snapshots CampaignMetricSnapshot[]
  actions   CampaignAction[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, providerCampaignId])
}

model CampaignMetricSnapshot {
  id                 String   @id @default(cuid(2))
  workspaceId        String
  campaignId         String
  campaign           Campaign @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  dateStart          DateTime
  dateStop           DateTime
  /// Ad-account currency minor units.
  spendMinor         BigInt
  leads              Int
  cplMinor           BigInt?
  attributionSetting String?
  asOf               DateTime

  @@unique([campaignId, dateStart, dateStop])
  @@index([workspaceId, dateStart])
}

model CampaignAction {
  id                     String              @id @default(cuid(2))
  workspaceId            String
  campaignId             String
  campaign               Campaign            @relation(fields: [workspaceId, campaignId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  targetStatus           String
  state                  CampaignActionState @default(PENDING)
  providerResultRedacted String?
  requestedBy            String
  idempotencyKey         String              @unique
  createdAt              DateTime            @default(now())
  resolvedAt             DateTime?

  @@index([workspaceId, createdAt])
}

model Integration {
  id                String            @id @default(cuid(2))
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  kind              IntegrationKind
  status            IntegrationStatus @default(NOT_CONFIGURED)
  /// Non-secret config: phoneNumberId, wabaId, businessPortfolioId, pageId, adAccountId, sheetId,
  /// fromDomain, modelId.
  config            Json
  /// Lookup column for webhook routing: phone_number_id or page_id (never payload trust).
  routingKey        String?           @unique
  /// field -> ciphertext `v1.<kid>.<nonce>.<ct>.<tag>`, AAD `workspaceId|integrationId|field` (A33).
  secrets           Json?
  secretLast4       Json?
  lastCheckedAt     DateTime?
  lastErrorCode     String?
  lastErrorRedacted String?
  qualityRaw        String?
  messagingLimitRaw String?
  limitsCheckedAt   DateTime?
  verifiedAt        DateTime?

  sheetMappings    SheetMapping[]
  metaFormMappings MetaFormMapping[]
  templates        WhatsAppTemplate[]
  campaigns        Campaign[]
  sheetSyncRuns    SheetSyncRun[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, kind])
}

model ExtensionToken {
  id                 String    @id @default(cuid(2))
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name               String
  /// `alx_<keyId>`.
  prefix             String    @unique
  /// sha256 of the secret; the secret is shown once and never stored.
  secretHash         String
  /// ['ingest:gmaps']
  scopes             Json
  allowedExtensionId String?
  createdBy          String
  createdAt          DateTime  @default(now())
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?

  importBatches ImportBatch[]

  @@unique([workspaceId, id])
}

/// Two payloads (E1, ADR-35): a redacted inspector view, and the full parsed body encrypted with
/// the credentials key ring (AAD = webhookEventId), purged after processing plus retention.
/// Idempotency is scoped by the authenticated source (E2, ADR-36).
model WebhookEvent {
  id                 String          @id @default(cuid(2))
  /// Null until routed.
  workspaceId        String?
  provider           WebhookProvider
  integrationId      String?
  /// Routed integrationId, else authenticated workspaceId, else `unrouted` (E2).
  scopeKey           String
  /// meta:{page}:{leadgen}, wa:{msgId}, wa:{wamid}:{status}, svix-id, sheets eventId, extension batchId.
  externalKey        String
  bodySha256         String
  payloadRedacted    Json
  /// AES-256-GCM ciphertext of the parsed body (E1).
  processingPayload  String?
  processingPurgedAt DateTime?
  status             WebhookStatus   @default(RECEIVED)
  attempts           Int             @default(0)
  /// Stored per-record results for replay.
  result             Json?
  simulated          Boolean         @default(false)
  receivedAt         DateTime
  processedAt        DateTime?

  @@unique([provider, scopeKey, externalKey])
  @@index([status, receivedAt])
  @@index([workspaceId, receivedAt])
  @@index([processingPurgedAt, processedAt])
}

/// Written on rejection only; the body is never persisted.
model WebhookRejection {
  id          String          @id @default(cuid(2))
  workspaceId String?
  provider    WebhookProvider
  reason      String
  /// UTC midnight of the rejection day.
  day         DateTime
  count       Int             @default(0)

  @@unique([provider, workspaceId, reason, day])
  /// NULLs are distinct in a unique index, so unrouted rejections get their own key (ADR-47).
  @@unique([provider, reason, day], map: "WebhookRejection_unrouted_day", where: raw("\"workspaceId\" IS NULL"))
  @@index([workspaceId, day])
}

// ---- Jobs, audit, pipeline (plan §4.3, §5.7) ------------------------------------------------

/// Claimed only by the single statement in src/server/db/raw/claim-job.ts.
/// workspaceId is a plain column (no foreign key): it is null for system jobs, and every
/// job-driven write is fenced and scoped by the job context (E5, E10).
model Job {
  id                String            @id @default(cuid(2))
  /// Null only for system jobs.
  workspaceId       String?
  type              String
  payload           Json
  payloadVersion    Int               @default(1)
  status            JobStatus         @default(QUEUED)
  priority          Int               @default(0)
  runAt             DateTime
  attempts          Int               @default(0)
  maxAttempts       Int               @default(5)
  claimToken        String?
  leaseUntil        DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  serialKey         String?
  idempotencyKey    String            @unique
  cancelRequestedAt DateTime?
  deadReason        String?
  lastErrorCode     String?
  lastErrorRedacted String?
  retrySafe         Boolean           @default(false)
  correlationId     String
  causationId       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  attemptLog        JobAttempt[]
  dispatchAttempts  DispatchAttempt[]

  @@index([status, runAt, priority])
  @@index([workspaceId, status])
  @@index([serialKey, status])
}

model JobAttempt {
  id                 String             @id @default(cuid(2))
  /// Copied from Job (E10).
  workspaceId        String?
  jobId              String
  job                Job                @relation(fields: [jobId], references: [id])
  attemptNo          Int
  startedAt          DateTime
  finishedAt         DateTime?
  /// Null while the attempt is in flight.
  outcome            JobAttemptOutcome?
  errorCode          String?
  errorRedacted      String?
  providerHttpStatus Int?
  providerRequestId  String?
  durationMs         Int?
  correlationId      String

  @@unique([jobId, attemptNo])
  @@index([workspaceId, startedAt])
}

model WorkerHeartbeat {
  workerId     String   @id
  pid          Int
  hostname     String
  version      String
  mode         AppMode
  startedAt    DateTime
  lastBeatAt   DateTime
  currentJobId String?
}

/// workspaceId is a plain nullable column: platform-level and denied cross-tenant events have none.
model AuditEvent {
  id             String      @id @default(cuid(2))
  workspaceId    String?
  actorUserId    String?
  actorKind      ActorKind
  /// e.g. `quote.approve`.
  action         String
  targetType     String
  targetId       String
  result         AuditResult
  /// Redacted field names, never PII values.
  summary        Json
  crossWorkspace Boolean     @default(false)
  reason         String?
  correlationId  String
  simulated      Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model PipelineConfigVersion {
  id           String               @id @default(cuid(2))
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  version      Int
  /// 5 fixed stage kinds, DAG order.
  graph        Json
  approvalMode PipelineApprovalMode @default(HUMAN)
  active       Boolean              @default(false)
  createdBy    String
  createdAt    DateTime             @default(now())

  leads      Lead[]
  executions PipelineExecution[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, version])
  @@unique([workspaceId], map: "PipelineConfigVersion_one_active", where: raw("\"active\""))
}

model PipelineExecution {
  id                      String                @id @default(cuid(2))
  workspaceId             String
  leadId                  String                @unique
  lead                    Lead                  @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Pinned (O5).
  pipelineConfigVersionId String
  pipelineConfigVersion   PipelineConfigVersion @relation(fields: [workspaceId, pipelineConfigVersionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  currentStage            PipelineStage         @default(INGESTION)
  updatedAt               DateTime              @updatedAt

  stageRuns PipelineStageRun[]
  aiDrafts  AiDraft[]

  @@unique([workspaceId, id])
}

model PipelineStageRun {
  id          String            @id @default(cuid(2))
  workspaceId String
  executionId String
  execution   PipelineExecution @relation(fields: [workspaceId, executionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  stage       PipelineStage
  status      StageRunStatus    @default(PENDING)
  /// e.g. scoreVersion, draft messageId, quoteId, approvalId, dispatchAttemptId.
  outputRef   Json?
  jobId       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  reasonCode  String?

  /// E9 idempotency: a stage runs at most once per execution.
  @@unique([executionId, stage])
  @@index([workspaceId, status])
}

// ---- AI drafts (T14, ADR-55) -------------------------------------------------------------------

/// One generated draft bundle for a lead: approved-template variable values, a follow-up text, an
/// email subject and body, and a structured quote proposal (service ids, quantities, scope,
/// timeline; never a price). Prices in `pricingPreview` come only from the server's
/// PricingVersion. Model output that broke the output policy is not stored; only the violation
/// (field + rule) is. At most one draft per pipeline execution (E9).
model AiDraft {
  id                String             @id @default(cuid(2))
  workspaceId       String
  leadId            String
  lead              Lead               @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  executionId       String?            @unique
  execution         PipelineExecution? @relation(fields: [workspaceId, executionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  trigger           AiDraftTrigger
  status            AiDraftStatus
  /// anthropic, openai, local-deterministic, or none (no generator produced output).
  generatorLabel    String
  modelId           String?
  /// sha256 of the canonical generation input (the local generator is keyed by it).
  inputHash         String
  /// string[]: values for the approved template's body variables, in order.
  templateVariables Json
  followUpText      String?
  emailSubject      String?
  emailBody         String?
  /// { items: [{ serviceId, qty }], scopeText, timelineText } after strip-and-flag (C12).
  proposal          Json?
  /// Server-priced preview of the proposal (decimal-string paise), from computeQuoteTotals.
  pricingPreview    Json?
  aiPolicyFlags     Json
  reviewReasons     Json
  /// [{ field, rule }]: output-policy hits; the offending text itself is not stored.
  policyViolations  Json
  escalated         Boolean            @default(false)
  errorCode         String?
  errorRedacted     String?
  /// userId or `system:<jobType>`.
  requestedBy       String
  correlationId     String
  createdAt         DateTime           @default(now())

  @@unique([workspaceId, id])
  @@index([workspaceId, leadId, createdAt])
  @@index([workspaceId, status, createdAt])
}

// ---- Bulk actions (T23, ADR-61) ---------------------------------------------------------------

/// BulkRun.action: what a bulk run does to each selected lead.
enum BulkRunAction {
  SEND_WHATSAPP_TEMPLATE
  SEND_EMAIL
}

/// BulkRun.status: QUEUED until the `bulk.run` job starts, RUNNING while it works through the
/// selection, COMPLETED when every row has a result.
enum BulkRunStatus {
  QUEUED
  RUNNING
  COMPLETED
}

/// One bulk action over a lead selection (T23, plan §11, AT13, 06-design F19). The request stores
/// the selection and the pre-flight counts; the `bulk.run` job writes one result per row
/// (`results`, selection order) and the three counts, so `queued + skipped + failed = selected`
/// and the result drawer survives a reload. Per-row eligibility is the shared dispatch eligibility
/// function with sendIntent BULK.
model BulkRun {
  id            String        @id @default(cuid(2))
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  action        BulkRunAction
  status        BulkRunStatus @default(QUEUED)
  /// Client idempotency key: a repeated request (double click, retry) returns the same run.
  requestKey    String
  /// { templateId, variables } or { subject, body }; never contact data.
  params        Json
  /// string[]: the selected lead ids, in selection order.
  leadIds       Json
  selectedCount Int
  queuedCount   Int           @default(0)
  skippedCount  Int           @default(0)
  failedCount   Int           @default(0)
  /// [{ leadId, outcome: QUEUED | SKIPPED | FAILED, reasons[], deferred, messageId?, attemptId? }].
  results       Json
  /// Counts from the pre-flight shown when the run was confirmed: { eligible, skipped, failed }.
  preflight     Json
  jobId         String?
  /// userId of the person who confirmed the run.
  requestedBy   String
  correlationId String
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@unique([workspaceId, id])
  @@unique([workspaceId, requestKey])
  @@index([workspaceId, createdAt])
}

// ---- Lead CSV exports (T26, ADR-70) ------------------------------------------------------------

/// LeadExport.status: QUEUED until the `leads.export` job wrote the file, READY while it can be
/// downloaded, FAILED when the job gave up, EXPIRED once `leads.exportPurge` deleted the file.
enum LeadExportStatus {
  QUEUED
  READY
  FAILED
  EXPIRED
}

/// One CSV export of a workspace's leads (T26, plan §11 M4, ADR-70). The request stores the list
/// filters it was made with; the `leads.export` job writes the file to
/// `STORAGE_DIR/exports/<workspaceId>/<id>.csv` (sha256 and size kept here) and schedules
/// `leads.exportPurge` at `expiresAt` (24 h after the file was written), which deletes it. Only
/// the person who requested an export can download it, and every download is audited.
model LeadExport {
  id               String           @id @default(cuid(2))
  workspaceId      String
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// Client idempotency key: a repeated request (double click, retry) returns the same export.
  requestKey       String
  status           LeadExportStatus @default(QUEUED)
  /// The list query the export ran with: { q?, stage?, source?, score?, sort }. Never filtered on.
  filters          Json
  /// userId of the person who asked for the export.
  requestedBy      String
  correlationId    String
  jobId            String?
  rowCount         Int?
  /// More rows matched than the export cap; the file holds the first ones in list order.
  truncated        Boolean          @default(false)
  /// Relative to STORAGE_DIR.
  path             String?
  sha256           String?
  bytes            Int?
  errorCode        String?
  createdAt        DateTime         @default(now())
  completedAt      DateTime?
  expiresAt        DateTime?
  purgedAt         DateTime?
  downloadCount    Int              @default(0)
  lastDownloadedAt DateTime?

  @@unique([workspaceId, id])
  @@unique([workspaceId, requestKey])
  @@index([workspaceId, requestedBy, createdAt])
}

// ---- Google Sheets sync (T34) ------------------------------------------------------------------

/// SheetSyncRun.status: QUEUED until the `sheets.sync` job claims it, RUNNING while it reads and
/// ingests, SUCCEEDED or FAILED when it settles, BLOCKED when the Sheet's header row no longer
/// matches the confirmed mapping (drift; nothing is read until the mapping is re-confirmed).
enum SheetSyncStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

/// One "Sync now" run of a workspace's Google Sheets integration (T34, ADR-104). Rows after
/// `cursorRow` are read through the service account, mapped with the active SheetMapping and
/// ingested through `ingestBatch` (ImportBatch `sheets-sync:<id>`). The next run starts after the
/// last SUCCEEDED run's `cursorRow` (1 = the header row, so the first run reads from row 2).
model SheetSyncRun {
  id             String          @id @default(cuid(2))
  workspaceId    String
  integrationId  String
  integration    Integration     @relation(fields: [workspaceId, integrationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  status         SheetSyncStatus @default(QUEUED)
  /// The SheetMapping version the run mapped rows with.
  mappingVersion Int?
  /// userId of the person who pressed Sync now.
  requestedBy    String
  correlationId  String
  jobId          String?
  /// First sheet row read and the row up to which everything is done (the next run's start - 1).
  fromRow        Int?
  cursorRow      Int?
  rowsRead       Int             @default(0)
  created        Int             @default(0)
  duplicate      Int             @default(0)
  review         Int             @default(0)
  rejected       Int             @default(0)
  /// Empty rows and rows still waiting for their auralead_event_id.
  skipped        Int             @default(0)
  /// Rows identified by a content hash because the Sheet has no auralead_event_id column.
  weakIdRows     Int             @default(0)
  importBatchId  String?
  /// BLOCKED: { added: string[], removed: string[] }; SUCCEEDED: { pendingRows: number[] }. Never filtered on.
  detail         Json?
  errorCode      String?
  errorRedacted  String?
  createdAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?

  @@unique([workspaceId, id])
  @@unique([integrationId], map: "SheetSyncRun_one_open_per_integration", where: raw("\"status\" IN ('QUEUED', 'RUNNING')"))
  @@index([workspaceId, integrationId, createdAt])
}
